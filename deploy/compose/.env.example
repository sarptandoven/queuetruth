# Copy to deploy/compose/.env and replace every value; never commit .env. With QT_ENV=prod (the compose default) the
# services refuse placeholder, empty or short values.
# Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(32))"
QT_PG_PASSWORD=change-me
QT_APP_PASSWORD=change-me
QT_WORKER_PASSWORD=change-me
QT_S3_ACCESS_KEY_ID=change-me
QT_S3_SECRET_ACCESS_KEY=change-me-change-me
QT_KEY_PEPPER=change-me
QT_SIGNING_KEY=change-me
# Optional: QT_PUBLIC_BASE_URL, QT_S3_PUBLIC_ENDPOINT, QT_ZERO_EGRESS, QT_WORKER_CONCURRENCY, QT_TENANT_MAX_RUNNING,
# QT_API_PORT, QT_S3_PORT, QT_API_MEM_LIMIT, QT_WORKER_MEM_LIMIT, QT_JOB_MEMORY_BYTES, QT_JOB_TIMEOUT_S (7200 s for
# every job kind), QT_JOB_TIMEOUTS_S (per-kind timeouts as JSON {kind: seconds}, default {}).
# Exposure (default 127.0.0.1 only): QT_API_BIND, QT_S3_BIND. Trusted reverse proxies: QT_FORWARDED_ALLOW_IPS.
