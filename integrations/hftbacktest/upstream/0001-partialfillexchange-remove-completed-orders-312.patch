+++ b/py-hftbacktest/tests/test_partial_fill_312.py
@@ -0,0 +1,138 @@
+"""Regression tests for #312: PartialFillExchange must remove an order that a maker fill completes.
+
+Before the fix, a queue-position fill equal to the order's leaves quantity (or leaving a sub-lot floating-point
+residual) marked the order as filled but left it in the book; the next trade at or through its price made
+`elapse` return 14 (InvalidOrderStatus) and stopped the backtest.
+"""
+
+import unittest
+
+import numpy as np
+
+from hftbacktest import BacktestAsset, HashMapMarketDepthBacktest
+from hftbacktest.order import FILLED, GTX, LIMIT, PARTIALLY_FILLED
+from hftbacktest.types import (
+    BUY_EVENT,
+    DEPTH_EVENT,
+    EXCH_EVENT,
+    LOCAL_EVENT,
+    SELL_EVENT,
+    TRADE_EVENT,
+    event_dtype,
+)
+
+ORDER_ID = 1
+
+
+def _events(rows):
+    data = np.zeros(len(rows), event_dtype)
+    for i, (ev, ts, px, qty) in enumerate(rows):
+        data[i]["ev"] = EXCH_EVENT | LOCAL_EVENT | ev
+        data[i]["exch_ts"] = ts
+        data[i]["local_ts"] = ts
+        data[i]["px"] = px
+        data[i]["qty"] = qty
+    return data
+
+
+def _run(rows, lot_size, buy, price, qty):
+    """Submits one GTX order after the first row; returns (elapse codes, [(status, exec_qty, leaves_qty)])."""
+    asset = (
+        BacktestAsset()
+        .data(_events(rows))
+        .linear_asset(1.0)
+        .constant_order_latency(0, 0)
+        .risk_adverse_queue_model()
+        .partial_fill_exchange()
+        .trading_value_fee_model(0.0, 0.0)
+        .tick_size(0.01)
+        .lot_size(lot_size)
+    )
+    hbt = HashMapMarketDepthBacktest([asset])
+    codes = [hbt.elapse(0)]
+    submit = hbt.submit_buy_order if buy else hbt.submit_sell_order
+    codes.append(submit(0, ORDER_ID, price, qty, GTX, LIMIT, False))
+    states = []
+    while True:
+        rc = hbt.elapse(1)
+        codes.append(rc)
+        if rc not in (0, 1):
+            break
+        o = hbt.orders(0).get(ORDER_ID)
+        state = (int(o.status), float(o.exec_qty), float(o.leaves_qty))
+        if not states or states[-1] != state:
+            states.append(state)
+        if rc == 1:
+            break
+    hbt.close()
+    return codes, states
+
+
+class TestPartialFill312(unittest.TestCase):
+    def test_fill_equal_to_leaves_removes_buy_order(self):
+        rows = [
+            (DEPTH_EVENT | BUY_EVENT, 1, 100.0, 1.0),
+            (DEPTH_EVENT | SELL_EVENT, 1, 100.01, 5.0),
+            (TRADE_EVENT | SELL_EVENT, 3, 100.0, 2.0),
+            (TRADE_EVENT | SELL_EVENT, 4, 100.0, 1.0),
+            (TRADE_EVENT | SELL_EVENT, 5, 100.0, 1.0),
+        ]
+        codes, states = _run(rows, 1.0, True, 100.0, 2.0)
+        self.assertEqual(codes[-1], 1)  # end of data, not 14
+        self.assertEqual(states[-2:], [(PARTIALLY_FILLED, 1.0, 1.0), (FILLED, 1.0, 0.0)])
+
+    def test_fill_equal_to_leaves_removes_sell_order(self):
+        rows = [
+            (DEPTH_EVENT | BUY_EVENT, 1, 99.99, 5.0),
+            (DEPTH_EVENT | SELL_EVENT, 1, 100.0, 1.0),
+            (TRADE_EVENT | BUY_EVENT, 3, 100.0, 2.0),
+            (TRADE_EVENT | BUY_EVENT, 4, 100.0, 1.0),
+            (TRADE_EVENT | BUY_EVENT, 5, 100.02, 3.0),
+        ]
+        codes, states = _run(rows, 1.0, False, 100.0, 2.0)
+        self.assertEqual(codes[-1], 1)
+        self.assertEqual(states[-1], (FILLED, 1.0, 0.0))
+
+    def test_sub_lot_residual_completes_the_order(self):
+        # lot 0.01, qty 0.1 as in the report: leaves 0.1 - 0.01 = 0.09000000000000001 > 9 * 0.01.
+        rows = [
+            (DEPTH_EVENT | BUY_EVENT, 1, 100.0, 0.01),
+            (DEPTH_EVENT | SELL_EVENT, 1, 100.01, 5.0),
+            (TRADE_EVENT | SELL_EVENT, 3, 100.0, 0.02),
+            (TRADE_EVENT | SELL_EVENT, 4, 100.0, 0.09),
+            (TRADE_EVENT | SELL_EVENT, 5, 100.0, 0.01),
+        ]
+        codes, states = _run(rows, 0.01, True, 100.0, 0.1)
+        self.assertEqual(codes[-1], 1)
+        self.assertEqual(states[-1], (FILLED, 0.09, (0.1 - 0.01) - 0.09))
+
+    def test_sub_lot_leaves_of_non_lot_quantity_complete_the_order(self):
+        # qty 1.4 with lot 1: the 0.4 left after a one-lot fill rounds to zero lots.
+        rows = [
+            (DEPTH_EVENT | BUY_EVENT, 1, 100.0, 1.0),
+            (DEPTH_EVENT | SELL_EVENT, 1, 100.01, 5.0),
+            (TRADE_EVENT | SELL_EVENT, 3, 100.0, 2.0),
+            (TRADE_EVENT | SELL_EVENT, 4, 100.0, 2.0),
+        ]
+        codes, states = _run(rows, 1.0, True, 100.0, 1.4)
+        self.assertEqual(codes[-1], 1)
+        self.assertEqual(states[-1], (FILLED, 1.0, 1.4 - 1.0))
+
+    def test_genuine_partial_fill_keeps_resting(self):
+        rows = [
+            (DEPTH_EVENT | BUY_EVENT, 1, 100.0, 1.0),
+            (DEPTH_EVENT | SELL_EVENT, 1, 100.01, 5.0),
+            (TRADE_EVENT | SELL_EVENT, 3, 100.0, 2.0),
+            (TRADE_EVENT | SELL_EVENT, 4, 100.0, 1.0),
+            (TRADE_EVENT | SELL_EVENT, 5, 100.0, 4.0),
+        ]
+        codes, states = _run(rows, 1.0, True, 100.0, 3.0)
+        self.assertEqual(codes[-1], 1)
+        self.assertEqual(
+            states[1:],
+            [(PARTIALLY_FILLED, 1.0, 2.0), (PARTIALLY_FILLED, 1.0, 1.0), (FILLED, 1.0, 0.0)],
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
