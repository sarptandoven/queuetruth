{
 "schema": "qtbench.targets",
 "schema_version": 1,
 "source": "SPEC.md section 7.1 (release build, Apple silicon arm64, 8 cores, 16 GB; single thread unless stated)",
 "targets": [
  {"path": "ITCH parse + map to MboEvent, no output", "op": ">=", "value": 5.0e6, "unit": "msg/s",
   "cases": ["core.synth2m.itch_parse", "core.synth10m.itch_parse"], "et_ref": "et.micro.itch_10m_parse_convert"},
  {"path": "ITCH -> dataset Parquet (ingest)", "op": ">=", "value": 2.5e6, "unit": "msg/s",
   "cases": ["ingest.synth.itch"], "et_ref": null},
  {"path": "etcsv -> dataset Parquet", "op": ">=", "value": 1.5e6, "unit": "records/s",
   "cases": ["ingest.real_day1.etcsv"], "et_ref": "et.day1.read_floor (I/O floor only)"},
  {"path": "Replay from Parquet, book + invariants, no sinks", "op": ">=", "value": 8.0e6, "unit": "records/s",
   "cases": ["core.synth10m.replay_book", "core.real_day1.replay_book"],
   "et_ref": "et.micro.replay_2m_nullsink (in memory); et.day1.replay_plain (from CSV, CSV sinks to /dev/null)"},
  {"path": "Replay with change-only BBO + trades Parquet sinks", "op": ">=", "value": 4.0e6, "unit": "records/s",
   "cases": ["core.synth10m.replay_sinks", "core.real_day1.replay_sinks"],
   "et_ref": "et.micro.replay_2m_nullsink extra csv_sink_records_per_s"},
  {"path": "Replay with rank oracle + rank_trace", "op": ">=", "value": 3.0e6, "unit": "records/s",
   "cases": ["core.synth10m.replay_rank", "core.real_day1.replay_rank"],
   "et_ref": "et.day1.replay_rd2 (/dev/null sinks), et.day1_disk.replay_rd2 (audit-comparable)"},
  {"path": "Shadow overhead, 3,000 shadows on a 4-symbol day", "op": "<=", "value": 0.15, "unit": "throughput loss",
   "derived": ["core.real_day1.shadow_overhead_3k", "core.synth10m.shadow_overhead_3k"],
   "et_ref": "et.day1.shadow_overhead_3k"},
  {"path": "Replay with 100,000 shadows, book + invariants", "op": ">=", "value": 5.0e6, "unit": "records/s",
   "cases": ["core.synth2m.replay_shadows_100k", "core.synth10m.replay_shadows_100k", "core.real_day1.replay_shadows_100k"],
   "et_ref": "et.day1.shadow_overhead_100k (cost ratio, informational: core.*.shadow_overhead_100k)"},
  {"path": "Trajectory ahead", "op": "<=", "value": 0.10, "unit": "extra (throughput loss)",
   "derived": ["core.real_day1.trajectory_ahead_extra", "core.synth10m.trajectory_ahead_extra"],
   "et_ref": "et.day1.trace_extra (et --queue-trace for all 3,000 ids)"},
  {"path": "L2Builder depth 10, cadence 0", "op": ">=", "value": 3.0e6, "unit": "records/s",
   "cases": ["core.synth10m.l2_d10", "core.real_day1.l2_d10"], "et_ref": "et.day1.replay_depth10 (CSV depth)"},
  {"path": "Zoo, 17 models x 3,000 shadows, 4-symbol day, single thread", "op": "<=", "value": 240, "unit": "s",
   "cases": ["zoo.real_day1.all_t1"], "also": "RSS <= 1.5 GB (peak_rss_bytes_max)", "et_ref": null},
  {"path": "Zoo, --threads 4", "op": "<=", "value": 90, "unit": "s", "cases": ["zoo.real_day1.all_t4"],
   "also": "RSS <= 1.5 GB", "et_ref": null},
  {"path": "Features, 20,000 shadows x 3 landmarks, one day", "op": "<=", "value": 120, "unit": "s",
   "cases": ["ana.real_day1.features_20k"], "et_ref": "et run_fidelity pandas features (inside 570 s, not isolated)"},
  {"path": "fit-hazard, 60,000 order-landmarks", "op": "<=", "value": 120, "unit": "s",
   "cases": ["ana.real_day1.fit_hazard_60k"], "et_ref": null},
  {"path": "score, 10,000 live orders, B = 1,000", "op": "<=", "value": 60, "unit": "s",
   "cases": ["ana.real_day1.score_10k", "ana.fixture.score_10k"], "et_ref": null},
  {"path": "Day-one real pipeline end to end", "op": "<=", "value": 900, "unit": "s",
   "cases": ["e2e.real_day1"], "also": "peak RSS <= 2 GB (extra peak_rss_bytes_stages), scratch <= 3 GB (extra scratch_bytes)",
   "et_ref": "et run_fidelity alone: 570 s, ~3.0 GB RSS, 1.5 GB written (audit 2026-10-18, not re-measured)"},
  {"path": "qt.replay() via Python vs queuetruth-core replay", "op": "<=", "value": 1.05, "unit": "cost ratio",
