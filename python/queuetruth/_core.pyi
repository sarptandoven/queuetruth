class IexSplit:
    """The fast engine of `scripts/scale/iex_split.py`: `feed` returns `[(bucket, pcap records)]` to append after
    each bucket's pcap file header; `stats` the counters and maps of the Python `IexSplitter`."""

    def __init__(
        self, k: int, midnight_utc_ns: int, symbols: list[str] | None = None, patterns: list[bytes] | None = None
    ) -> None: ...
    def feed(self, data: bytes) -> list[tuple[int, bytes]]: ...
    def stats(self) -> dict[str, Any]: ...
