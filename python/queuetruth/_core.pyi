"""Type stubs of the Rust extension `queuetruth._core` (SPEC 4.3). Native operations take a spec JSON string and
return the summary JSON string; every call that does work releases the GIL. Rust errors raise `QtCoreError`."""

from typing import Any

import pyarrow as pa

class QtCoreError(Exception):
    """args = (code, message)."""

    code: str
    message: str

class CliExit(Exception):
    """args = (code, text, to_stderr)."""

    code: int
    text: str
    to_stderr: bool

