{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "qt.pm_fixtures",
  "$defs": {
    "FileEntry": {
      "additionalProperties": false,
      "description": "One output file: name relative to the output directory, row count for tables, size and sha256.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "rows": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rows"
        },
        "bytes": {
          "title": "Bytes",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "name",
        "bytes",
        "sha256"
      ],
      "title": "FileEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "What `pm fixtures` wrote (printed; the files are the output).",
  "properties": {
    "schema": {
      "const": "qt.pm_fixtures",
      "default": "qt.pm_fixtures",
      "title": "Schema",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "out": {
      "title": "Out",
      "type": "string"
    },
    "note": {
      "title": "Note",
      "type": "string"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/FileEntry"
      },
      "title": "Files",
      "type": "array"
    }
  },
  "required": [
    "schema",
    "schema_version",
    "out",
    "note",
    "files"
  ],
  "type": "object"
}
