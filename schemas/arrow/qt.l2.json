      "nullable": false
    },
    {
      "name": "instrument_id",
      "type": "uint32",
      "nullable": false
    },
    {
      "name": "event_id",
      "type": "uint64",
      "nullable": false
    },
    {
      "name": "sequence",
      "type": "uint64",
      "nullable": false
    },
    {
      "name": "kind",
      "type": "dictionary<int8, utf8>",
      "nullable": false,
