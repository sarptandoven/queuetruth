        "depth",
        "trade",
        "snapshot",
        "clear"
      ]
    },
    {
      "name": "side",
      "type": "uint8",
      "nullable": false
    },
    {
      "name": "price",
      "type": "int64",
      "nullable": true
    },
    {
      "name": "prev_qty",
      "type": "uint64",
      "nullable": false
    },
    {
      "name": "new_qty",
      "type": "uint64",
      "nullable": false
    },
    {
      "name": "prev_ct",
      "type": "uint32",
      "nullable": true
    },
    {
      "name": "new_ct",
      "type": "uint32",
      "nullable": true
    },
    {
      "name": "trade_qty",
      "type": "uint64",
      "nullable": false
    },
    {
      "name": "aggressor",
      "type": "uint8",
      "nullable": false
    },
    {
      "name": "level",
      "type": "uint8",
      "nullable": false
    },
    {
      "name": "flags",
      "type": "uint8",
      "nullable": false
    }
  ]
