{
  "name": "qt.shadow_spec",
  "metadata": {
    "qt.engine_version": "0.2.0",
    "qt.schema": "qt.shadow_spec",
    "qt.schema_version": "1.1"
  },
  "fields": [
    {
      "name": "shadow_id",
      "type": "utf8",
      "nullable": false
    },
    {
      "name": "instrument_id",
      "type": "uint32",
      "nullable": false
    },
    {
      "name": "side",
      "type": "uint8",
      "nullable": false
    },
    {
      "name": "price_mode",
      "type": "dictionary<int8, utf8>",
