      "values": [
        "abs",
        "touch"
      ]
    },
    {
      "name": "price",
      "type": "int64",
      "nullable": true
    },
    {
      "name": "offset_ticks",
      "type": "int32",
      "nullable": false
    },
    {
      "name": "qty",
      "type": "uint64",
      "nullable": false
    },
    {
      "name": "ts_submit",
      "type": "timestamp[ns, tz=UTC]",
      "nullable": false
    },
    {
      "name": "latency_ns",
      "type": "int64",
      "nullable": false
    },
    {
      "name": "ts_cancel",
      "type": "timestamp[ns, tz=UTC]",
      "nullable": true
    },
    {
      "name": "group",
      "type": "utf8",
      "nullable": true
    },
    {
      "name": "source",
      "type": "dictionary<int8, utf8>",
      "nullable": false,
      "values": [
