{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "qt.shadow_sample_summary",
  "$defs": {
    "FileEntry": {
      "additionalProperties": false,
      "description": "One output file: name relative to the output directory, row count for tables, size and sha256.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "rows": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rows"
        },
        "bytes": {
          "title": "Bytes",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "name",
        "bytes",
        "sha256"
      ],
      "title": "FileEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Summary of `shadows sample`, `shadows mirror-real` and `shadows from-live`.",
  "properties": {
    "schema": {
      "const": "qt.shadow_sample_summary",
      "default": "qt.shadow_sample_summary",
      "title": "Schema",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "spec": {
      "additionalProperties": true,
      "title": "Spec",
      "type": "object"
    },
    "n": {
      "title": "N",
      "type": "integer"
    },
    "by_instrument": {
      "patternProperties": {
        "^-?[0-9]+$": {
          "type": "integer"
        }
      },
      "title": "By Instrument",
      "type": "object"
    },
    "by_placement": {
      "patternProperties": {
        "^-?[0-9]+$": {
          "type": "integer"
        }
      },
      "title": "By Placement",
      "type": "object"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/FileEntry"
      },
      "title": "Files",
      "type": "array"
    }
  },
  "required": [
    "schema",
    "schema_version",
    "spec",
    "n",
    "by_instrument",
    "by_placement",
    "files"
  ],
  "type": "object"
}
