{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "qt.mirror_spec",
  "$defs": {
    "DatasetIdRef": {
      "additionalProperties": false,
      "description": "Service dataset id reference (HTTP API).",
      "properties": {
        "dataset_id": {
          "title": "Dataset Id",
          "type": "string"
        }
      },
      "required": [
        "dataset_id"
      ],
      "title": "DatasetIdRef",
      "type": "object"
    },
    "PathRef": {
      "additionalProperties": false,
      "description": "Local path reference (CLI, Python API, MCP local mode).",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "title": "PathRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "`shadows mirror-real`: shadows joining directly behind sampled real orders.",
  "properties": {
    "dataset": {
      "anyOf": [
        {
          "$ref": "#/$defs/PathRef"
        },
        {
          "$ref": "#/$defs/DatasetIdRef"
        }
      ],
      "description": "Dataset directory.",
      "title": "Dataset"
    },
    "out": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Output shadow spec file (Parquet).",
      "title": "Out"
    },
    "n": {
      "default": 3000,
      "description": "Number of shadows.",
      "minimum": 0,
      "title": "N",
      "type": "integer"
    },
    "seed": {
      "default": 0,
      "description": "Random seed.",
      "minimum": 0,
      "title": "Seed",
      "type": "integer"
    },
    "stratify": {
      "default": true,
      "description": "Stratify the sampled real orders by instrument and outcome.",
      "title": "Stratify",
      "type": "boolean"
    },
    "placement": {
      "const": "behind_real",
      "default": "behind_real",
      "description": "Where each shadow joins: behind_real.",
      "title": "Placement",
      "type": "string"
    }
  },
  "required": [
    "dataset"
  ],
  "type": "object"
}
