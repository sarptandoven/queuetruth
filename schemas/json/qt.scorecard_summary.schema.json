        "bucket": {
          "title": "Bucket",
          "type": "integer"
        },
        "both": {
          "title": "Both",
          "type": "integer"
        },
        "neither": {
          "title": "Neither",
          "type": "integer"
        },
        "live_only": {
          "title": "Live Only",
          "type": "integer"
        },
        "sim_only": {
          "title": "Sim Only",
          "type": "integer"
        },
        "p_exact": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "P Exact"
        },
        "p_adj": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "P Adj"
        }
      },
      "required": [
        "bucket",
        "both",
        "neither",
        "live_only",
        "sim_only",
        "p_exact",
        "p_adj"
      ],
      "title": "LiquidityRow",
      "type": "object"
    },
    "MarkoutDiffRow": {
      "additionalProperties": false,
      "description": "Paired first-fill markout difference (sim minus live).",
      "properties": {
        "horizon_ns": {
          "title": "Horizon Ns",
          "type": "integer"
        },
        "ref": {
          "enum": [
            "mid",
            "microprice"
