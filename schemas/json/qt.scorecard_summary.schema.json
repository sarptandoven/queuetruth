      "type": "object"
    },
    "MarkoutRow": {
      "additionalProperties": false,
      "description": "Mean markout of one arm at one horizon.",
      "properties": {
        "horizon_ns": {
          "title": "Horizon Ns",
          "type": "integer"
        },
        "ref": {
          "enum": [
            "mid",
            "microprice"
          ],
          "title": "Ref",
          "type": "string"
        },
        "arm": {
          "enum": [
            "live",
            "sim"
          ],
          "title": "Arm",
          "type": "string"
        },
        "n": {
          "title": "N",
          "type": "integer"
        },
        "mean_ticks": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Mean Ticks"
        },
        "ci_lo": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ci Lo"
        },
        "ci_hi": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
