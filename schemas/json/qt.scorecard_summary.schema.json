{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "qt.scorecard_summary",
  "$defs": {
    "ArmCounts": {
      "additionalProperties": false,
      "description": "A count per scorecard arm.",
      "properties": {
        "live": {
          "title": "Live",
          "type": "integer"
        },
        "sim": {
          "title": "Sim",
          "type": "integer"
        }
      },
      "required": [
        "live",
        "sim"
      ],
      "title": "ArmCounts",
      "type": "object"
    },
    "Bias": {
      "additionalProperties": false,
      "description": "Signed fill-rate and quantity bias (sim minus live).",
      "properties": {
        "fill_rate_bias": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Fill Rate Bias"
        },
        "ci_lo": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ci Lo"
        },
        "ci_hi": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ci Hi"
        },
        "relative_overfill": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Relative Overfill"
        },
        "qty_bias": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Qty Bias"
        },
        "qty_bias_ci_lo": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Qty Bias Ci Lo"
        },
        "qty_bias_ci_hi": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Qty Bias Ci Hi"
        },
        "direction": {
          "enum": [
            "sim_overfills",
            "sim_underfills",
            "no_significant_bias"
          ],
          "title": "Direction",
          "type": "string"
        }
      },
      "required": [
        "fill_rate_bias",
        "ci_lo",
        "ci_hi",
        "relative_overfill",
        "qty_bias",
        "qty_bias_ci_lo",
        "qty_bias_ci_hi",
        "direction"
      ],
      "title": "Bias",
      "type": "object"
    },
    "DataQuality": {
      "additionalProperties": false,
      "description": "Data-quality counters and verdict (SPEC 5.1.5).",
      "properties": {
        "schema": {
          "const": "qt.data_quality",
          "default": "qt.data_quality",
          "title": "Schema",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "records": {
          "title": "Records",
          "type": "integer"
        },
        "maybe_bad_book_records": {
          "title": "Maybe Bad Book Records",
          "type": "integer"
        },
        "bad_ts_recv_records": {
          "title": "Bad Ts Recv Records",
          "type": "integer"
        },
        "snapshot_records": {
          "title": "Snapshot Records",
          "type": "integer"
        },
        "pre_snapshot_rows_skipped": {
          "title": "Pre Snapshot Rows Skipped",
          "type": "integer"
        },
        "unknown_order_refs": {
          "title": "Unknown Order Refs",
          "type": "integer"
        },
        "duplicate_adds": {
          "title": "Duplicate Adds",
          "type": "integer"
        },
        "unexpected_modifies": {
          "title": "Unexpected Modifies",
          "type": "integer"
        },
        "sequence_gaps": {
          "title": "Sequence Gaps",
          "type": "integer"
        },
        "sequence_regressions": {
          "title": "Sequence Regressions",
          "type": "integer"
        },
        "out_of_order_ts_event": {
          "title": "Out Of Order Ts Event",
          "type": "integer"
        },
        "crossed_books_after_last": {
          "title": "Crossed Books After Last",
          "type": "integer"
        },
        "hidden_prints": {
          "title": "Hidden Prints",
          "type": "integer"
        },
        "off_price_executions": {
          "title": "Off Price Executions",
          "type": "integer"
        },
        "feed_gaps": {
          "items": {
            "$ref": "#/$defs/FeedGap"
          },
          "title": "Feed Gaps",
          "type": "array"
        },
        "trading_halts": {
          "items": {
            "$ref": "#/$defs/TradingHaltSpan"
          },
          "title": "Trading Halts",
          "type": "array"
        },
        "source_specific": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Source Specific",
          "type": "object"
        },
        "verdict": {
          "enum": [
            "clean",
            "warnings",
            "unusable"
          ],
          "title": "Verdict",
          "type": "string"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        }
      },
      "required": [
        "schema",
        "schema_version",
        "records",
        "maybe_bad_book_records",
        "bad_ts_recv_records",
        "snapshot_records",
        "pre_snapshot_rows_skipped",
        "unknown_order_refs",
        "duplicate_adds",
        "unexpected_modifies",
        "sequence_gaps",
        "sequence_regressions",
        "out_of_order_ts_event",
        "crossed_books_after_last",
        "hidden_prints",
        "off_price_executions",
        "feed_gaps",
        "source_specific",
        "verdict",
        "reasons"
      ],
      "title": "DataQuality",
      "type": "object"
    },
    "DecileRow": {
      "additionalProperties": false,
      "description": "2x2 table and test within one queue decile.",
      "properties": {
        "decile": {
          "title": "Decile",
          "type": "integer"
        },
        "both": {
          "title": "Both",
          "type": "integer"
        },
        "neither": {
          "title": "Neither",
          "type": "integer"
        },
        "live_only": {
          "title": "Live Only",
          "type": "integer"
        },
        "sim_only": {
          "title": "Sim Only",
          "type": "integer"
        },
        "p_exact": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "P Exact"
        },
        "p_adj": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "P Adj"
        }
      },
      "required": [
        "decile",
        "both",
        "neither",
        "live_only",
        "sim_only",
        "p_exact",
        "p_adj"
      ],
      "title": "DecileRow",
      "type": "object"
    },
    "DiscordanceClustered": {
      "additionalProperties": false,
      "description": "1.1 (3.11 #9): the cluster-robust primary discordance test (audit ruling A10).",
      "properties": {
        "method": {
          "title": "Method",
          "type": "string"
        },
        "estimate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Estimate"
        },
        "ci_lo": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ci Lo"
        },
        "ci_hi": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ci Hi"
        },
        "p_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "P Value"
        },
        "n_clusters": {
          "title": "N Clusters",
          "type": "integer"
        },
        "n_clusters_discordant": {
          "title": "N Clusters Discordant",
          "type": "integer"
        },
        "design_effect": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Design Effect"
        },
        "n_effective": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "N Effective"
        }
      },
      "required": [
        "method",
        "estimate",
        "ci_lo",
        "ci_hi",
        "p_value",
        "n_clusters",
        "n_clusters_discordant",
        "design_effect",
        "n_effective"
      ],
      "title": "DiscordanceClustered",
      "type": "object"
    },
    "DiscordantMarkoutRow": {
      "additionalProperties": false,
      "description": "Markouts of sim-only vs live-only fills.",
      "properties": {
        "horizon_ns": {
          "title": "Horizon Ns",
          "type": "integer"
        },
        "sim_only_mean": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Sim Only Mean"
        },
        "live_only_mean": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Live Only Mean"
        },
        "diff": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Diff"
        },
        "ci_lo": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ci Lo"
        },
        "ci_hi": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ci Hi"
        }
      },
      "required": [
        "horizon_ns",
        "sim_only_mean",
        "live_only_mean",
        "diff",
        "ci_lo",
        "ci_hi"
      ],
      "title": "DiscordantMarkoutRow",
      "type": "object"
    },
    "Equivalence": {
      "additionalProperties": false,
      "description": "TOST equivalence results.",
      "properties": {
        "fill_rate_margin": {
          "title": "Fill Rate Margin",
          "type": "number"
        },
        "tost_p": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Tost P"
        },
        "fill_rate_equivalent": {
          "title": "Fill Rate Equivalent",
          "type": "boolean"
        },
        "markout_margin_ticks": {
          "title": "Markout Margin Ticks",
          "type": "number"
        },
        "markout_horizon_ns": {
          "title": "Markout Horizon Ns",
          "type": "integer"
        },
        "markout_tost_p": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Markout Tost P"
        },
        "markout_equivalent": {
          "title": "Markout Equivalent",
          "type": "boolean"
        }
      },
      "required": [
        "fill_rate_margin",
        "tost_p",
        "fill_rate_equivalent",
        "markout_margin_ticks",
        "markout_horizon_ns",
        "markout_tost_p",
        "markout_equivalent"
      ],
      "title": "Equivalence",
      "type": "object"
    },
    "Fdr": {
      "additionalProperties": false,
      "description": "Multiple-testing summary.",
      "properties": {
        "method": {
          "enum": [
            "bh",
            "by"
          ],
          "title": "Method",
          "type": "string"
        },
        "q": {
          "title": "Q",
          "type": "number"
        },
        "n_tests": {
          "title": "N Tests",
          "type": "integer"
        },
        "n_rejected": {
          "title": "N Rejected",
          "type": "integer"
        }
      },
      "required": [
        "method",
        "q",
        "n_tests",
        "n_rejected"
      ],
      "title": "Fdr",
      "type": "object"
    },
    "FeedGap": {
      "additionalProperties": false,
      "description": "A gap in the feed of one instrument.",
      "properties": {
        "instrument_id": {
          "title": "Instrument Id",
          "type": "integer"
        },
        "ts_start": {
          "title": "Ts Start",
          "type": "integer"
        },
        "ts_end": {
          "title": "Ts End",
          "type": "integer"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "instrument_id",
        "ts_start",
        "ts_end",
        "reason"
      ],
      "title": "FeedGap",
      "type": "object"
    },
    "FileEntry": {
      "additionalProperties": false,
      "description": "One output file: name relative to the output directory, row count for tables, size and sha256.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "rows": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rows"
        },
        "bytes": {
          "title": "Bytes",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "name",
        "bytes",
        "sha256"
      ],
      "title": "FileEntry",
      "type": "object"
    },
    "LiquidityRow": {
      "additionalProperties": false,
      "description": "2x2 table and test within one liquidity bucket.",
