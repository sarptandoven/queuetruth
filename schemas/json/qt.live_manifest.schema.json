{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "qt.live_manifest",
  "$defs": {
    "LiveCoverage": {
      "additionalProperties": false,
      "description": "1.1 (3.11 #14): order-source coverage of a live log: orders known only from fills.",
      "properties": {
        "fills_only": {
          "title": "Fills Only",
          "type": "boolean"
        },
        "n_fills_only_orders": {
          "title": "N Fills Only Orders",
          "type": "integer"
        }
      },
      "required": [
        "fills_only",
        "n_fills_only_orders"
      ],
      "title": "LiveCoverage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "`manifest.json` of a canonical live-log directory (SPEC 3.8).",
  "properties": {
    "schema": {
      "const": "qt.live_manifest",
      "default": "qt.live_manifest",
      "title": "Schema",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "venues": {
      "items": {
        "type": "string"
      },
      "title": "Venues",
      "type": "array"
    },
    "accounts": {
      "items": {
        "type": "string"
      },
      "title": "Accounts",
      "type": "array"
    },
    "n_orders": {
      "title": "N Orders",
      "type": "integer"
    },
    "n_events": {
      "title": "N Events",
      "type": "integer"
    },
    "instrument_map_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Instrument Map Sha256"
    },
    "created_by": {
      "title": "Created By",
      "type": "string"
    },
    "coverage": {
      "anyOf": [
        {
          "$ref": "#/$defs/LiveCoverage"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "entry_fallback_share": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Entry Fallback Share"
    }
  },
  "required": [
    "schema",
    "schema_version",
    "venues",
    "accounts",
    "n_orders",
    "n_events",
    "created_by"
  ],
  "type": "object"
}
