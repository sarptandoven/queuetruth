        "title": {
          "title": "Title",
          "type": "string"
        },
        "format": {
          "enum": [
            "itch",
            "iex"
          ],
          "title": "Format",
          "type": "string"
        },
        "session_date": {
          "title": "Session Date",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "default_symbols": {
          "items": {
            "type": "string"
          },
          "title": "Default Symbols",
          "type": "array"
        },
        "attribution": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Attribution"
