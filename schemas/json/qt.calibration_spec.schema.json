{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "qt.calibration_spec",
  "$defs": {
    "BlockWindow": {
      "additionalProperties": false,
      "description": "Block selection: equal-duration blocks of each date's continuous session.",
      "properties": {
        "index": {
          "items": {
            "minimum": 0,
            "type": "integer"
          },
          "title": "Index",
          "type": "array"
        },
        "n_blocks": {
          "default": 5,
          "minimum": 1,
          "title": "N Blocks",
          "type": "integer"
        }
      },
      "required": [
        "index"
      ],
      "title": "BlockWindow",
      "type": "object"
    },
    "BootstrapSpec": {
      "additionalProperties": false,
      "description": "Block bootstrap settings; `auto` = day blocks with >= 5 dates, else 30-minute blocks.",
      "properties": {
        "b": {
          "minimum": 1,
          "title": "B",
          "type": "integer"
        },
        "block": {
          "default": "auto",
          "enum": [
            "auto",
            "day",
            "30min"
          ],
          "title": "Block",
          "type": "string"
        },
        "seed": {
          "default": 0,
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        }
      },
      "required": [
        "b"
      ],
      "title": "BootstrapSpec",
      "type": "object"
    },
    "CalibrationGrid": {
      "additionalProperties": false,
      "description": "Optimizer grids: alloc in ln n, databento and survival in k.",
      "properties": {
        "alloc": {
          "$ref": "#/$defs/GridRange"
        },
        "databento": {
          "$ref": "#/$defs/GridRange"
        },
        "survival": {
          "$ref": "#/$defs/GridRange"
        }
      },
      "title": "CalibrationGrid",
      "type": "object"
    },
    "DatasetIdRef": {
      "additionalProperties": false,
      "description": "Service dataset id reference (HTTP API).",
      "properties": {
        "dataset_id": {
          "title": "Dataset Id",
          "type": "string"
        }
      },
      "required": [
        "dataset_id"
      ],
      "title": "DatasetIdRef",
      "type": "object"
    },
    "GridRange": {
      "additionalProperties": false,
      "description": "Evenly spaced grid `lo..=hi` with `n` points.",
      "properties": {
        "lo": {
          "title": "Lo",
          "type": "number"
        },
        "hi": {
          "title": "Hi",
          "type": "number"
        },
        "n": {
          "minimum": 1,
          "title": "N",
          "type": "integer"
        }
      },
      "required": [
        "lo",
        "hi",
        "n"
      ],
      "title": "GridRange",
      "type": "object"
    },
    "JobFile": {
      "additionalProperties": false,
      "description": "One output file of a service job.",
      "properties": {
        "job_id": {
          "title": "Job Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "job_id",
        "name"
      ],
      "title": "JobFile",
      "type": "object"
    },
    "JobFileRef": {
      "additionalProperties": false,
      "description": "Reference to a service job output file.",
      "properties": {
        "job_file": {
          "$ref": "#/$defs/JobFile"
        }
      },
      "required": [
        "job_file"
      ],
      "title": "JobFileRef",
      "type": "object"
    },
    "L2Config": {
      "additionalProperties": false,
      "description": "L2 view synthesis settings (SPEC 5.3.1).",
      "properties": {
        "depth_levels": {
          "default": 10,
          "maximum": 65535,
          "minimum": 0,
          "title": "Depth Levels",
          "type": "integer"
        },
        "cadence_ns": {
          "default": 0,
          "minimum": 0,
          "title": "Cadence Ns",
          "type": "integer"
        },
        "trade_position": {
          "default": "before",
          "enum": [
            "before",
            "after"
          ],
          "title": "Trade Position",
          "type": "string"
        },
        "include_counts": {
          "default": true,
          "title": "Include Counts",
          "type": "boolean"
        },
        "emit_hidden_trades": {
          "default": true,
          "title": "Emit Hidden Trades",
          "type": "boolean"
        }
      },
      "title": "L2Config",
      "type": "object"
    },
    "PathRef": {
      "additionalProperties": false,
      "description": "Local path reference (CLI, Python API, MCP local mode).",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "title": "PathRef",
      "type": "object"
    },
    "UploadRef": {
      "additionalProperties": false,
      "description": "Service upload id reference (HTTP API).",
      "properties": {
        "upload_id": {
          "title": "Upload Id",
          "type": "string"
        }
      },
      "required": [
        "upload_id"
      ],
      "title": "UploadRef",
      "type": "object"
    },
    "WindowSpec": {
      "additionalProperties": false,
      "description": "Train/test window: dates or blocks; both null = all data.",
      "properties": {
        "dates": {
          "anyOf": [
            {
              "items": {
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dates"
        },
        "blocks": {
          "anyOf": [
            {
              "$ref": "#/$defs/BlockWindow"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "WindowSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "`calibrate`: fit queue-model parameters against exact truth, or latency from live logs.",
  "properties": {
    "kind": {
      "enum": [
        "alloc",
        "survival",
        "nt_touch",
        "latency"
      ],
      "title": "Kind",
      "type": "string"
    },
    "family": {
      "enum": [
        "power",
        "power2",
        "power3",
        "databento",
        "nt_prob_touch",
        "nt_queue_l2_prob_touch",
        "latency"
      ],
      "title": "Family",
      "type": "string"
    },
    "dataset": {
      "anyOf": [
        {
          "$ref": "#/$defs/PathRef"
        },
        {
          "$ref": "#/$defs/DatasetIdRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dataset"
    },
    "shadows": {
      "anyOf": [
        {
          "$ref": "#/$defs/PathRef"
        },
        {
          "$ref": "#/$defs/UploadRef"
        },
        {
          "$ref": "#/$defs/JobFileRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Shadows"
    },
    "live": {
      "anyOf": [
        {
          "$ref": "#/$defs/PathRef"
        },
        {
          "$ref": "#/$defs/UploadRef"
        },
        {
          "$ref": "#/$defs/JobFileRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Live"
    },
    "train": {
      "$ref": "#/$defs/WindowSpec"
    },
    "test": {
      "$ref": "#/$defs/WindowSpec"
    },
    "out": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Out"
    },
    "mode": {
      "default": "faithful",
      "enum": [
        "faithful",
        "corrected"
      ],
      "title": "Mode",
      "type": "string"
    },
    "exchange": {
      "default": "partial",
      "enum": [
        "partial",
        "no_partial"
      ],
      "title": "Exchange",
      "type": "string"
    },
    "l2": {
      "$ref": "#/$defs/L2Config"
    },
    "horizons_ns": {
      "items": {
        "minimum": 0,
        "type": "integer"
      },
      "title": "Horizons Ns",
      "type": "array"
    },
    "h_max_ns": {
      "default": 300000000000,
      "minimum": 0,
      "title": "H Max Ns",
      "type": "integer"
    },
    "grid": {
      "$ref": "#/$defs/CalibrationGrid"
    },
    "bootstrap": {
      "$ref": "#/$defs/BootstrapSpec"
    },
    "particles": {
      "default": 100,
      "minimum": 1,
      "title": "Particles",
      "type": "integer"
    },
    "seed": {
      "default": 0,
      "minimum": 0,
      "title": "Seed",
      "type": "integer"
    },
    "threads": {
      "default": 1,
      "minimum": 1,
      "title": "Threads",
      "type": "integer"
    }
  },
  "required": [
    "kind",
    "family"
  ],
  "type": "object"
}
