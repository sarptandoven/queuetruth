{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "qt.zoo_spec",
  "$defs": {
    "DatasetIdRef": {
      "additionalProperties": false,
      "description": "Service dataset id reference (HTTP API).",
      "properties": {
        "dataset_id": {
          "title": "Dataset Id",
          "type": "string"
        }
      },
      "required": [
        "dataset_id"
      ],
      "title": "DatasetIdRef",
      "type": "object"
    },
    "ExcludeOrderId": {
      "additionalProperties": false,
      "description": "One real order removed from the tape before shadows are injected (audit ruling A1, self-exclusion).",
      "properties": {
        "instrument_id": {
          "minimum": 0,
          "title": "Instrument Id",
          "type": "integer"
        },
        "order_id": {
          "minimum": 0,
          "title": "Order Id",
          "type": "integer"
        },
        "session_date": {
          "anyOf": [
            {
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Date"
        }
      },
      "required": [
        "instrument_id",
        "order_id"
      ],
      "title": "ExcludeOrderId",
      "type": "object"
    },
    "JobFile": {
      "additionalProperties": false,
      "description": "One output file of a service job.",
      "properties": {
        "job_id": {
          "title": "Job Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "job_id",
        "name"
      ],
      "title": "JobFile",
      "type": "object"
    },
    "JobFileRef": {
      "additionalProperties": false,
      "description": "Reference to a service job output file.",
      "properties": {
        "job_file": {
          "$ref": "#/$defs/JobFile"
        }
      },
      "required": [
        "job_file"
      ],
      "title": "JobFileRef",
      "type": "object"
    },
    "L2Config": {
      "additionalProperties": false,
      "description": "L2 view synthesis settings (SPEC 5.3.1).",
      "properties": {
        "depth_levels": {
          "default": 10,
          "maximum": 65535,
          "minimum": 0,
          "title": "Depth Levels",
          "type": "integer"
        },
        "cadence_ns": {
          "default": 0,
          "minimum": 0,
          "title": "Cadence Ns",
          "type": "integer"
        },
        "trade_position": {
          "default": "before",
          "enum": [
            "before",
            "after"
          ],
          "title": "Trade Position",
          "type": "string"
        },
        "include_counts": {
          "default": true,
          "title": "Include Counts",
          "type": "boolean"
        },
        "emit_hidden_trades": {
          "default": true,
          "title": "Emit Hidden Trades",
          "type": "boolean"
        }
      },
      "title": "L2Config",
      "type": "object"
    },
    "LatencyModel": {
      "additionalProperties": false,
      "description": "Shadow latency components (SPEC 3.1 semantics).",
      "properties": {
        "feed_ns": {
          "default": 0,
          "minimum": 0,
          "title": "Feed Ns",
          "type": "integer"
        },
        "decision_ns": {
          "default": 0,
          "minimum": 0,
          "title": "Decision Ns",
          "type": "integer"
        },
        "gateway_ns": {
          "default": 0,
          "minimum": 0,
          "title": "Gateway Ns",
          "type": "integer"
        },
        "jitter_ns": {
          "default": 0,
          "minimum": 0,
          "title": "Jitter Ns",
          "type": "integer"
        }
      },
      "title": "LatencyModel",
      "type": "object"
    },
    "PathRef": {
      "additionalProperties": false,
      "description": "Local path reference (CLI, Python API, MCP local mode).",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "title": "PathRef",
      "type": "object"
    },
    "UploadRef": {
      "additionalProperties": false,
      "description": "Service upload id reference (HTTP API).",
      "properties": {
        "upload_id": {
          "title": "Upload Id",
          "type": "string"
        }
      },
      "required": [
        "upload_id"
      ],
      "title": "UploadRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "`zoo`: run queue models on the L2 view and compare with exact truth.",
  "properties": {
    "dataset": {
      "anyOf": [
        {
          "$ref": "#/$defs/PathRef"
        },
        {
          "$ref": "#/$defs/DatasetIdRef"
        }
      ],
      "title": "Dataset"
    },
    "shadows": {
      "anyOf": [
        {
          "$ref": "#/$defs/PathRef"
        },
        {
          "$ref": "#/$defs/UploadRef"
        },
        {
          "$ref": "#/$defs/JobFileRef"
        }
      ],
      "title": "Shadows"
    },
    "out": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Out"
    },
    "models": {
      "items": {
        "type": "string"
      },
      "title": "Models",
      "type": "array"
    },
    "mode": {
      "default": "faithful",
      "enum": [
        "faithful",
        "corrected"
      ],
      "title": "Mode",
      "type": "string"
    },
    "exchange": {
      "default": "partial",
      "enum": [
        "partial",
        "no_partial"
      ],
      "title": "Exchange",
      "type": "string"
    },
    "horizons_ns": {
      "items": {
        "minimum": 0,
        "type": "integer"
      },
      "title": "Horizons Ns",
      "type": "array"
    },
    "h_max_ns": {
      "default": 300000000000,
      "minimum": 0,
      "title": "H Max Ns",
      "type": "integer"
    },
    "l2": {
      "$ref": "#/$defs/L2Config"
    },
    "particles": {
      "default": 100,
      "minimum": 1,
      "title": "Particles",
      "type": "integer"
    },
    "seed": {
      "default": 0,
      "minimum": 0,
      "title": "Seed",
      "type": "integer"
    },
    "latency": {
      "$ref": "#/$defs/LatencyModel"
    },
    "write_fills": {
      "default": true,
      "title": "Write Fills",
      "type": "boolean"
    },
    "write_trajectory": {
      "default": false,
      "title": "Write Trajectory",
      "type": "boolean"
    },
    "threads": {
      "default": 1,
      "minimum": 1,
      "title": "Threads",
      "type": "integer"
    },
    "bootstrap_b": {
      "default": 1000,
      "minimum": 1,
      "title": "Bootstrap B",
      "type": "integer"
    },
    "amends": {
      "anyOf": [
        {
          "$ref": "#/$defs/PathRef"
        },
        {
          "$ref": "#/$defs/UploadRef"
        },
        {
          "$ref": "#/$defs/JobFileRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Amends"
    },
    "exclude_order_ids": {
      "items": {
        "$ref": "#/$defs/ExcludeOrderId"
      },
      "title": "Exclude Order Ids",
      "type": "array"
    }
  },
  "required": [
    "dataset",
    "shadows"
  ],
  "type": "object"
}
